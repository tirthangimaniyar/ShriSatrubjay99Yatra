# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/palitana_99_yatra?retryWrites=true&w=majority

# CORS Configuration (Comma-separated allowed frontend origins)
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Seeded on first launch)
ADMIN_EMAIL=admin@palitana99yatra.org
ADMIN_PASSWORD=change_this_secure_admin_password
ADMIN_NAME=Palitana Yatra Samiti Admin
